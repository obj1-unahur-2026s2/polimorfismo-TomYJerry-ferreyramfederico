import tomYJerry.*

describe "primer test" {
  test "la velocidad maxima de Tom es 10" {
    assert.equals(10, tom.velocidadMaxima())
  }
  
  test "Tom come a Jerry y la velocidad maxima pasa a ser 15.2" {
    tom.comer(jerry)
    assert.equals(15.2, tom.velocidadMaxima())
  }

  test "Tom corre 24 metros, entonces su velocidad maxima pasa a ser 14" {
    tom.comer(jerry)
    tom.correr(24)
    assert.equals(14, tom.velocidadMaxima())
  }
  test "Tom come a Nibbles y pasa a tener de velocidad maxima 18.7" {
    tom.comer(jerry)
    tom.correr(24)
    tom.comer(nibbles)
    assert.equals(18.7, tom.velocidadMaxima())
  }

  test "Jerry cumple años(3 años) y om lo vuelve a comer, pasaria a tener 25.9 de velocidad maxima" {
    tom.comer(jerry)
    tom.correr(24)
    tom.comer(nibbles)
    jerry.cumplirAnios()
    tom.comer(jerry)
    assert.equals(25.9, tom.velocidadMaxima())
  }  

  test "Tom corre 38 metros, su velocidad maxima pasa a ser 24" {
    tom.comer(jerry)
    tom.correr(24)
    tom.comer(nibbles)
    jerry.cumplirAnios()
    tom.comer(jerry)
    tom.correr(38)
    assert.equals(24, tom.velocidadMaxima())
  }

  test "Tom esta feliz" {
    tom.comer(jerry)
    tom.correr(24)
    tom.comer(nibbles)
    jerry.cumplirAnios()
    tom.comer(jerry)
    tom.correr(38)
    assert.that(tom.estaFeliz())
  }

  test "Tom no esta feliz" {
    assert.notThat(tom.estaFeliz())
  }
}

